generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String               @id @default(uuid()) @db.Uuid
  provider         String               @default("google") @db.VarChar(30)
  provider_user_id String               @unique @db.VarChar(255)
  email            String               @unique @db.VarChar(255)
  email_verified   Boolean              @default(false)
  full_name        String?              @db.VarChar(255)
  avatar_url       String?
  last_login_at    DateTime?            @db.Timestamptz(6)
  status           String               @default("active") @db.VarChar(30)
  created_at       DateTime             @default(now()) @db.Timestamptz(6)
  updated_at       DateTime             @updatedAt @db.Timestamptz(6)
  is_deleted       Boolean              @default(false)
  deleted_by       String?              @db.Uuid
  deleted_at       DateTime?            @db.Timestamptz(6)
  refresh_tokens   RefreshToken[]
  memberships      OrganizationMember[]
  attendances      EventAttendance[]
  settlements      EventSettlement[]
  payments         Payment[]

  @@unique([provider, provider_user_id])
  @@map("users")
}

/// Một row = một refresh token đang/đã tồn tại. RT là chuỗi random opaque, DB chỉ lưu
/// SHA-256 của nó nên DB bị lộ cũng không dựng lại được token. Chỉ đủ cột để xoay vòng và
/// thu hồi — cố tình KHÔNG có device_id / last_used_at: đây không phải session management.
model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  user_id     String    @db.Uuid
  token_hash  String    @unique
  expires_at  DateTime  @db.Timestamptz(6)
  revoked_at  DateTime? @db.Timestamptz(6)
  /// Trỏ tới row thay thế nó khi rotate — để lần theo chuỗi khi điều tra reuse.
  replaced_by String?   @db.Uuid
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  user        User      @relation(fields: [user_id], references: [id])

  @@index([user_id, revoked_at])
  @@map("refresh_tokens")
}

// ===================== Nghiệp vụ nhóm cầu lông =====================
//
// Dùng Prisma enum (khác `users.status` vốn là VarChar) vì đây là tập đóng nằm giữa mọi
// nhánh nghiệp vụ — sai một chữ là bug thầm lặng. Đổi lại phải ALTER TYPE khi thêm giá trị.

enum MemberRole {
  ADMIN
  MEMBER
}

enum MemberStatus {
  ACTIVE
  LEFT
}

enum InviteType {
  EMAIL
  LINK
}

enum EventStatus {
  OPEN
  COMPLETED
  CANCELLED
}

/// Cố tình KHÔNG có WAITLIST: trận đủ người thì không vote GOING được nữa; ai bỏ vote thì
/// slot trống ra ngay cho người khác. Không hàng đợi, không auto-promote.
enum AttendanceStatus {
  GOING
  NOT_GOING
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model Organization {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(255)
  avatar_url String?
  created_by String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  members   OrganizationMember[]
  invites   OrganizationInvite[]
  templates EventTemplate[]
  events    Event[]
  payments  Payment[]

  @@map("organizations")
}

/// Rời nhóm không xoá row mà đặt status = LEFT — giữ lại lịch sử điểm danh/công nợ và cho
/// phép join lại bằng chính row cũ. Không soft-delete ở bảng nghiệp vụ nào khác.
model OrganizationMember {
  id              String       @id @default(uuid()) @db.Uuid
  organization_id String       @db.Uuid
  user_id         String       @db.Uuid
  role            MemberRole   @default(MEMBER)
  status          MemberStatus @default(ACTIVE)
  joined_at       DateTime     @default(now()) @db.Timestamptz(6)
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id])

  @@unique([organization_id, user_id])
  @@index([user_id, status])
  @@map("organization_members")
}

/// MVP chỉ dùng type = LINK. Cột `type`/`email` có sẵn để bật EMAIL sau mà không phải migrate.
/// Token thô chỉ xuất hiện một lần trong response lúc tạo, DB chỉ giữ SHA-256 — cùng cách
/// refresh_tokens đang làm.
model OrganizationInvite {
  id              String     @id @default(uuid()) @db.Uuid
  organization_id String     @db.Uuid
  type            InviteType @default(LINK)
  email           String?    @db.VarChar(255)
  token_hash      String     @unique
  expires_at      DateTime?  @db.Timestamptz(6)
  /// null = không giới hạn lượt dùng.
  max_uses        Int?
  used_count      Int        @default(0)
  revoked_at      DateTime?  @db.Timestamptz(6)
  created_by      String     @db.Uuid
  created_at      DateTime   @default(now()) @db.Timestamptz(6)
  updated_at      DateTime   @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, revoked_at])
  @@map("organization_invites")
}

/// Lịch định kỳ hàng tuần. Cron đọc bảng này sinh ra `events` cho 14 ngày tới.
model EventTemplate {
  id                       String   @id @default(uuid()) @db.Uuid
  organization_id          String   @db.Uuid
  name                     String   @db.VarChar(255)
  /// ISO-8601: 1 = thứ Hai … 7 = Chủ nhật.
  day_of_week              Int      @db.SmallInt
  start_time               DateTime @db.Time(0)
  end_time                 DateTime @db.Time(0)
  location_name            String?  @db.VarChar(255)
  location_address         String?
  court_cost               Int      @default(0)
  max_participants         Int
  /// Số phút trước giờ bắt đầu thì khoá vote.
  vote_lock_minutes_before Int      @default(0)
  active                   Boolean  @default(true)
  created_by               String   @db.Uuid
  created_at               DateTime @default(now()) @db.Timestamptz(6)
  updated_at               DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  events       Event[]

  @@index([organization_id, active])
  @@map("event_templates")
}

/// Một buổi đánh cụ thể. Sinh từ template xong là sống độc lập: sửa template không ảnh
/// hưởng trận đã sinh.
///
/// `source_template_id` + `occurrence_date` CHỈ tồn tại để cron idempotent (UNIQUE chặn sinh
/// trùng khi chạy lại hoặc chạy nhiều instance). Không logic nghiệp vụ nào đọc ngược về template.
model Event {
  id                 String      @id @default(uuid()) @db.Uuid
  organization_id    String      @db.Uuid
  title              String      @db.VarChar(255)
  start_at           DateTime    @db.Timestamptz(6)
  end_at             DateTime    @db.Timestamptz(6)
  location_name      String?     @db.VarChar(255)
  location_address   String?
  court_cost         Int         @default(0)
  /// [{ name: string, amount: int >= 0 }] — validate ở DTO, ghi đè cả mảng khi cập nhật.
  extra_costs        Json        @default("[]")
  max_participants   Int
  vote_locked_at     DateTime    @db.Timestamptz(6)
  status             EventStatus @default(OPEN)
  source_template_id String?     @db.Uuid
  occurrence_date    DateTime?   @db.Date
  created_by         String      @db.Uuid
  completed_at       DateTime?   @db.Timestamptz(6)
  cancelled_at       DateTime?   @db.Timestamptz(6)
  created_at         DateTime    @default(now()) @db.Timestamptz(6)
  updated_at         DateTime    @updatedAt @db.Timestamptz(6)

  organization    Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  source_template EventTemplate?    @relation(fields: [source_template_id], references: [id], onDelete: SetNull)
  attendances     EventAttendance[]
  settlements     EventSettlement[]

  @@unique([source_template_id, occurrence_date])
  @@index([organization_id, start_at])
  @@map("events")
}

/// `status` = ý định đi hay không (vote). `attended` = admin chấm thực tế sau buổi đánh;
/// null = chưa chấm. Chỉ người `attended = true` mới bị chia tiền.
model EventAttendance {
  id         String           @id @default(uuid()) @db.Uuid
  event_id   String           @db.Uuid
  user_id    String           @db.Uuid
  status     AttendanceStatus
  attended   Boolean?
  created_at DateTime         @default(now()) @db.Timestamptz(6)
  updated_at DateTime         @updatedAt @db.Timestamptz(6)

  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id])

  @@unique([event_id, user_id])
  @@index([event_id, status])
  @@map("event_attendances")
}

/// Một dòng nợ: user X nợ `amount` cho trận Y, đã trả `paid_amount`.
///
/// `paid_amount` là dữ liệu dẫn xuất nhưng vẫn lưu, vì màn công nợ đọc nhiều hơn ghi rất
/// nhiều. Bất biến giữ nó khỏi lệch: paid_amount CHỈ đổi bên trong transaction đổi trạng
/// thái payment, không có đường ghi nào khác.
model EventSettlement {
  id          String   @id @default(uuid()) @db.Uuid
  event_id    String   @db.Uuid
  user_id     String   @db.Uuid
  amount      Int
  paid_amount Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  event       Event               @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [user_id], references: [id])
  allocations PaymentAllocation[]

  @@unique([event_id, user_id])
  @@index([user_id])
  @@map("event_settlements")
}

/// Một lần trả tiền. MEMBER tạo → PENDING chờ admin duyệt; ADMIN tạo → CONFIRMED ngay
/// (tiền mặt tại sân). Chỉ allocation của payment CONFIRMED mới được cộng vào paid_amount.
model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  organization_id String        @db.Uuid
  user_id         String        @db.Uuid
  amount          Int
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  note            String?
  created_by      String        @db.Uuid
  confirmed_by    String?       @db.Uuid
  confirmed_at    DateTime?     @db.Timestamptz(6)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @updatedAt @db.Timestamptz(6)

  organization Organization        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [user_id], references: [id])
  allocations  PaymentAllocation[]

  @@index([organization_id, status])
  @@index([user_id, status])
  @@map("payments")
}

/// Payment được xé ra trả cho từng khoản nợ. Payment REJECTED vẫn giữ allocation làm dấu
/// vết, chỉ là không cộng vào đâu cả.
model PaymentAllocation {
  id            String   @id @default(uuid()) @db.Uuid
  payment_id    String   @db.Uuid
  settlement_id String   @db.Uuid
  amount        Int
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  payment    Payment         @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  settlement EventSettlement @relation(fields: [settlement_id], references: [id], onDelete: Cascade)

  @@unique([payment_id, settlement_id])
  @@map("payment_allocations")
}
