PORT=3000                              # cổng API, default 3000 (main.ts)
NODE_ENV=development                   # development|staging|production; production => cookie SameSite=None + Secure

DB_HOST=localhost                      # * host Postgres (database.service.ts)
DB_PORT=5432                           # default 5432 khi để trống (prisma.config.ts)
DB_USER=postgres                       # *
DB_PASSWORD=                           # *
DB_NAME=joytab                         # *
DB_PARAMS=                             # query params nối vào connection string, vd sslmode=require

GOOGLE_CLIENT_ID=                      # * OAuth client id (google.strategy.ts)
GOOGLE_CLIENT_SECRET=                  # * OAuth client secret

# AT 1 giờ / RT 7 ngày, TTL nằm trong code (auth.constants.ts). RT là chuỗi random 32 bytes,
# DB chỉ lưu SHA-256 nên không cần secret; muốn đăng xuất tất cả thì revoke bảng refresh_tokens.
JWT_ACCESS_SECRET=                     # * secret ký AT; sinh: openssl rand -base64 48. Đổi => AT cũ vô hiệu, RT vẫn sống

FRONTEND_ORIGIN=http://localhost:3000  # origin FE để redirect + CORS credentials; default http://localhost:3000 (main.ts)
API_URL=http://localhost:8000          # * base URL API, dựng ${API_URL}/auth/google/callback (google.strategy.ts)
COOKIE_DOMAIN=                         # domain chung cho cookie at/rt giữa FE + API, vd .joytab.com; trống = host-only (auth.utils.ts)
