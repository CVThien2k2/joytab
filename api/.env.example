# Chú thích: [bắt buộc] = nằm trong REQUIRED_ENV_KEYS (app.module.ts), thiếu là app ném lỗi
# khi bootstrap. [tùy chọn] = có default trong code hoặc chỉ dùng khi cần.

# ===== Application =====
# [tùy chọn] Cổng chạy Service API. Default 3000 trong code (main.ts).
PORT=3000
# [tùy chọn] Môi trường backend: development | staging | production
# production => cookie SameSite=None; Secure. Khác => SameSite=Lax; Secure=false.
NODE_ENV=development

# ===== Database (PostgreSQL) =====
# [bắt buộc] DB_HOST, DB_USER, DB_PASSWORD, DB_NAME (database.service.ts + validate ở app.module).
DB_HOST=localhost
# [tùy chọn] Default 5432 khi để trống (prisma.config.ts).
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=joytab
# [tùy chọn] Query params nối vào connection string, vd: sslmode=require
DB_PARAMS=

# ===== Google OAuth 2.0 =====
# [bắt buộc] GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET (google.strategy.ts).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== JWT =====
# [bắt buộc] Secret ký access token (jwt.service.ts). Sinh bằng: openssl rand -base64 48
# Đổi secret này = vô hiệu mọi AT đang lưu hành, user phải chờ FE refresh (tối đa 1 giờ)
# chứ không bị đăng xuất — RT vẫn còn sống trong DB.
# Refresh token KHÔNG dùng secret: là chuỗi random 32 bytes, DB chỉ lưu SHA-256
# (refresh-token.service.ts). Muốn đăng xuất toàn bộ user thì xoá/revoke bảng refresh_tokens.
# TTL cấu hình trong code, không qua env: AT 1 giờ, RT 7 ngày (auth.constants.ts).
JWT_ACCESS_SECRET=

# ===== Tích hợp FE-BE =====
# [tùy chọn] Origin FE để BE redirect và cấu hình CORS credentials: true. Default http://localhost:3000 (main.ts).
FRONTEND_ORIGIN=http://localhost:3000
# [bắt buộc] Base URL của API, dùng dựng callback Google: ${API_URL}/auth/google/callback (google.strategy.ts).
API_URL=http://localhost:8000
# [tùy chọn] Domain cookie first-party để 2 cookie `at`/`rt` dùng chung được giữa FE + API
# subdomain, vd .joytab.com. Để trống ở local (auth.utils.ts). Không set => cookie host-only.
COOKIE_DOMAIN=

